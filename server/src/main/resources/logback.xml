<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Без этого Netty засыпает консоль служебными DEBUG-сообщениями. -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
